# --- Общие ---
APP_NAME="Автомойка №1"
SECRET_KEY="change-me-to-a-long-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# Разрешённые адреса фронтенда через запятую. На продакшене укажите реальный домен.
CORS_ORIGINS="https://carwashone.ru,https://www.carwashone.ru,http://127.0.0.1:8123,http://localhost:8123"
BUSINESS_TIMEZONE="Asia/Yekaterinburg"

# --- База данных ---
# Для старта — локальный SQLite, для продакшена подставь Postgres:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/carwash
DATABASE_URL="sqlite:///./carwash.db"

# --- SMS.ru (для кода подтверждения при записи по телефону) ---
# API_ID берётся с главной страницы кабинета SMS.ru. Никогда не коммитьте реальный ключ.
SMS_PROVIDER_API_KEY=""
# Заполняйте только после одобрения буквенного имени в разделе «Отправители».
SMS_PROVIDER_SENDER=""
SMS_PROVIDER_TIMEOUT_SECONDS=10
# console — код в логах; smsru — SMS.ru; phone — рабочий Android-телефон.
SMS_DELIVERY_MODE="console"
# Сгенерируйте: openssl rand -hex 32. Один и тот же секрет указывается на сервере и телефоне.
PHONE_GATEWAY_TOKEN=""
PHONE_GATEWAY_NAME="redmi-7a"

# --- 2ГИС ---
# Заполнить, когда пришлёшь ссылку на филиал / API-ключ.
# ORG_ID — это id заведения из ссылки 2gis.ru/.../firm/ORG_ID
TWOGIS_API_KEY=""
TWOGIS_ORG_ID=""
TWOGIS_ORG_URL=""

# --- ВКонтакте (новости на сайт) ---
# group_domain — часть ссылки после vk.com/, например carwash_one_zkm
# access_token — НЕ коммить реальный токен в git! Задавай прямо в переменных
# окружения на сервере (панель хостинга), сюда — только для локальной разработки.
VK_GROUP_DOMAIN="carwash_one_zkm"
VK_ACCESS_TOKEN=""

# --- Тестовые доступы ---
# Для продакшена: TEST_MODE=false и обязательно замените оба пароля.
ADMIN_PHONE="+79990000000"
TEST_MODE=true
ADMIN_PASSWORD="admin"
MANAGER_PASSWORD="manager"
